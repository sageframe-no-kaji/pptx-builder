# PPTX Builder — environment variables
# Copy to .env and adjust. All values below are the defaults (no limits applied).
# For a restricted public demo, use the values shown in the comments.

# Max file size per upload in megabytes (demo: 20)
PPTX_MAX_FILE_MB=50

# Max number of files per batch (demo: 20)
PPTX_MAX_FILES=100

# Max DPI for PDF conversion (demo: 300)
PPTX_MAX_DPI=600

# Max pages converted per PDF — 0 means unlimited (demo: 20)
PPTX_MAX_PDF_PAGES=0

# Max JPEG quality a web visitor may select — 100 means uncapped (demo: 85).
# Quality and DPI multiply into output size; cap this on any public tier that
# does not also cap DPI and page count.
PPTX_MAX_QUALITY=100


# ── Output encoding defaults ─────────────────────────────────────────────────
# Unlike the PPTX_MAX_* ceilings above, these are user preferences honored by
# both the CLI and the web UI. They set the fall-through when no flag or widget
# says otherwise.

# Encoder for rasterized PDF pages: jpeg or png.
# jpeg is roughly 8x smaller on photographic slides; png is lossless.
# Set to png to restore pre-0.3.0 behavior.
PPTX_FORMAT=jpeg

# JPEG quality, 1-100. Ignored when PPTX_FORMAT=png.
PPTX_QUALITY=85

# Default DPI for PDF rasterization when --dpi is not given.
PPTX_DPI=200
