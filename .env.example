# PPTX Builder — environment variables
# Copy to .env and adjust. All values below are the defaults (no limits applied).
# For a restricted public demo, use the values shown in the comments.

# Max file size per upload in megabytes (demo: 20)
PPTX_MAX_FILE_MB=50

# Max number of files per batch (demo: 20)
PPTX_MAX_FILES=100

# Max DPI for PDF conversion (demo: 300)
PPTX_MAX_DPI=600

# Max pages converted per PDF — 0 means unlimited (demo: 20)
PPTX_MAX_PDF_PAGES=0
